table monthly_actual
	lineageTag: 0fd60a8a-1ba9-421d-b8b3-e33ab670877b

	column month
		dataType: dateTime
		formatString: Long Date
		lineageTag: 03511dd5-420e-49bb-aa52-b6b488d60022
		summarizeBy: none
		sourceColumn: month

		annotation UnderlyingDateTimeDataType = Date

	column actual_sales
		dataType: double
		formatString: #,0.00
		lineageTag: d92ec8e8-8ed1-40e6-af11-0e5aa16fff4e
		summarizeBy: sum
		sourceColumn: actual_sales

	partition monthly_actual = m
		mode: import
		source =
				let
					Source   = Csv.Document(File.Contents(Text.TrimEnd(DataFolder, "\") & "\forecast\monthly_sales_actual.csv"),
								[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed    = Table.TransformColumnTypes(Promoted, {{"month", type date}, {"actual_sales", type number}}, "en-US")
				in
					Typed

