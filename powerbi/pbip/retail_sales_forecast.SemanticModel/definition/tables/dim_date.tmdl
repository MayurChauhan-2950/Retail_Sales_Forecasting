table dim_date
	lineageTag: 3f50b96c-e446-494c-bf92-f5973c9f0773
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		lineageTag: ab7f781d-53f4-4d7b-a3d6-62436313ff39
		summarizeBy: none
		sourceColumn: date_key

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 12a85c98-7631-4308-b616-deccd75a0614
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
