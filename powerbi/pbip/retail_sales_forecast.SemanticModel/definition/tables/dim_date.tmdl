		formatString: 0
		lineageTag: 9c0af0c0-56f0-4d28-a1d6-cf7c629b2d22
		summarizeBy: none
		sourceColumn: WeekOfYear

	column Day
		dataType: int64
		formatString: 0
		lineageTag: af20e9b9-10d9-482e-9129-0b9e96aa2ae8
		summarizeBy: none
		sourceColumn: Day

	column DayOfWeek
		dataType: string
		lineageTag: 42b80890-a657-4202-82dd-681d3e3f1758
		summarizeBy: none
