	column QuarterLabel
		dataType: string
		lineageTag: d9d7a1c2-3b85-419d-a35c-5a66feb2b5a3
		summarizeBy: none
		sourceColumn: QuarterLabel

	column YearQuarter
		dataType: string
		lineageTag: 56782d14-f7d5-42ed-9850-97eb4b790ef2
		summarizeBy: none
		sourceColumn: YearQuarter

	column MonthShort
		dataType: string
